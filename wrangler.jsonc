{
  // Déploiement Cloudflare Workers en "assets-only" (aucun script Worker,
  // juste l'hébergement statique) — le site est généré par Pelican avant
  // `wrangler deploy` (voir la Build command dans les réglages Cloudflare).
  //
  // IMPORTANT : "name" doit correspondre EXACTEMENT au nom du Worker déjà
  // créé dans ton dashboard Cloudflare (Workers & Pages). Si le tien porte
  // un autre nom, remplace-le ici, sinon wrangler déploierait vers un autre
  // Worker que celui connecté au dépôt.
  "name": "thenaisie-site",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./output",
    // Toute adresse inconnue renvoie output/404.html avec un vrai statut 404
    // (avant : l'accueil avec un statut 200, y compris pour robots.txt).
    "not_found_handling": "404-page"
  }
}
